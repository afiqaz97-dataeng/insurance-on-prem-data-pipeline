# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- MSSQL (native, on-prem) ---
# Same var names used by Migration_Script/load_raw_to_mssql.py.
# Raw and curated data live in separate databases on the same server (access-control
# split) — TakafulPOC (raw, already loaded) and CuratedTakafulPOC (marts, load.py builds
# this in Phase 7). MSSQL_DATABASE stays pointed at the raw DB for the existing script;
# load.py will use MSSQL_CURATED_DATABASE instead.
MSSQL_SERVER=localhost,1433
MSSQL_DATABASE=TakafulPOC
MSSQL_CURATED_DATABASE=CuratedTakafulPOC
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Passw0rd
MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- MinIO (Docker) ---
# Host scripts (extract.py/load.py run outside Docker) hit MinIO's published port directly.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw-zone
MINIO_BUCKET_STAGING=staging-zone

# --- dbt-duckdb httpfs settings ---
# DuckDB's s3_endpoint wants host:port with no scheme (unlike MINIO_ENDPOINT above,
# which boto3 wants with the scheme) — see dbt_takaful/profiles.yml.
MINIO_ENDPOINT_HOST=localhost:9000
DBT_DUCKDB_PATH=../duckdb_data/takaful_transform.duckdb
